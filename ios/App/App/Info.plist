<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ELS Driver</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>INIntentsSupported</key>
	<array>
		<string>Intent</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>ELS Driver uses your camera to record vehicle condition before and after each shift.</string>
	<key>NSContactsUsageDescription</key>
	<string>ELS Elite can access your contacts to quickly book rides for friends and family.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>ELS Elite uses Face ID to securely authorise payments.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Please choose “Always Allow”. ELS Driver needs background location to keep your passenger updated when the app is not on screen — with “While Using the App” they lose sight of you the moment you switch away. Location is only shared while you are on shift.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Please choose “Always Allow”. ELS Driver needs background location to keep your passenger updated when the app is not on screen. Location is only shared while you are on shift.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ELS Driver shares your location while you are on shift so jobs can be dispatched to you and your passenger can follow the journey. Nothing is shared while you are offline.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ELS Driver uses your microphone to speak to passengers in-app and to capture audio during vehicle condition recordings.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ELS Driver accesses your photo library to attach images to vehicle reports.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
