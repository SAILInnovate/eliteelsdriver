<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ELS Driver</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ======================== -->
	<!-- LOCATION PERMISSIONS     -->
	<!-- ======================== -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location data is required to look for the nearest available chauffeurs. Please choose 'Allow while using app', and when you're in another city we'll send you a notification if Elite serves it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Elite ELS uses your location in the background to track your ride in real time and ensure your driver can find you.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Elite ELS uses your location in the background to provide live ride tracking and accurate ETAs.</string>

	<!-- ======================== -->
	<!-- PUSH NOTIFICATIONS       -->
	<!-- ======================== -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>

	<!-- ======================== -->
	<!-- CAMERA (Profile Photo)   -->
	<!-- ======================== -->
	<key>NSCameraUsageDescription</key>
	<string>ELS Driver uses your camera to record vehicle condition before and after each shift.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ELS Driver uses your microphone to capture audio during vehicle condition recordings.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ELS Driver accesses your photo library to attach images to vehicle reports.</string>

	<!-- ======================== -->
	<!-- FACE ID (Apple Pay)      -->
	<!-- ======================== -->
	<key>NSFaceIDUsageDescription</key>
	<string>Elite ELS uses Face ID to securely authorise payments.</string>

	<!-- ======================== -->
	<!-- CONTACTS (optional)      -->
	<!-- ======================== -->
	<key>NSContactsUsageDescription</key>
	<string>Elite ELS can access your contacts to quickly book rides for friends and family.</string>

	<!-- ======================== -->
	<!-- APP TRANSPORT SECURITY   -->
	<!-- ======================== -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- ======================== -->
	<!-- UI CONFIGURATION         -->
	<!-- ======================== -->
	<key>INIntentsSupported</key>
	<array>
		<string>Intent</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
</dict>
</plist>
